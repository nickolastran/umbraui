{
  "name": "umbra-ui-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w umbra-ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test -w umbra-ui",
    "storybook": "npm run storybook -w umbra-ui",
    "build-storybook": "npm run build-storybook -w umbra-ui",
    "size": "npm run size -w umbra-ui",
    "docs:dev": "npm run dev -w @umbra-ui/docs",
    "docs:build": "npm run build && npm run build -w @umbra-ui/docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
